<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Liste des cours</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
    }

    .page-title {
      color: #0d6efd;
      font-weight: bold;
    }

    .card {
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      border: none;
    }

    .table thead th {
      background-color: #0d6efd;
      color: white;
    }

    .btn-primary {
      background-color: #0d6efd;
      border-color: #0d6efd;
    }

    .btn-primary:hover {
      background-color: #0b5ed7;
      border-color: #0a58ca;
    }

    .btn-warning {
      color: white;
    }

    .action-cell {
      white-space: nowrap;
    }

    .bottom-actions {
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="container mt-5">
    <div class="text-center mb-4">
      <h1 class="page-title">Liste des cours</h1>
    </div>

    <% if (courses && courses.length > 0) { %>
      <div class="card p-3">
        <table class="table table-hover table-bordered align-middle">
          <thead>
            <tr>
              <th>Titre</th>
              <th>Description</th>
              <th>Max étudiants</th>
              <th>Coût (€)</th>
              <th class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% courses.forEach(course => { %>
              <tr>
                <td>
                  <a href="/courses/<%= course._id %>" class="text-decoration-none fw-bold text-dark">
                    <%= course.title %>
                  </a>
                </td>
                <td><%= course.description %></td>
                <td><%= course.maxStudents %></td>
                <td><%= course.cost %></td>
                <td class="text-center action-cell">
                  <a href="/courses/<%= course._id %>/edit" class="btn btn-warning btn-sm me-1">Modifier</a>
                  <form action="/courses/<%= course._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Supprimer ce cours ?')">
                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <form action="/users/<%= user._id %>?_method=DELETE" method="POST" style="display:inline;" onsubmit="return confirm('Supprimer cet utilisateur ?')">
        <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
      </form>
    <% } else { %>
      <div class="alert alert-info text-center">
        Aucun cours disponible pour le moment.
      </div>
     
    <% } %>
  </div>
</body>
</html>

