<h2>Détails de l'abonné</h2>

<p><strong>Nom :</strong> <%= subscriber.name %></p>
<p><strong>Email :</strong> <%= subscriber.email %></p>
<p><strong>Code postal :</strong> <%= subscriber.zipCode %></p>

<a href="/subscribers" class="btn">⬅ Retour à la liste</a>
<a href="/subscribers/<%= subscriber._id %>/edit" class="btn btn-edit">✏️ Modifier</a>

<form action="/subscribers/<%= subscriber._id %>/delete" method="POST" onsubmit="return confirm('Confirmer la suppression ?');" style="display:inline;">
  <button type="submit" class="btn btn-delete">🗑 Supprimer</button>
</form>
