<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 2rem;
    }
    h2 {
      margin-bottom: 20px;
    }
    .notification {
      background-color: #d4edda;
      color: #155724;
      padding: 10px;
      border: 1px solid #c3e6cb;
      border-radius: 5px;
      margin-bottom: 20px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    thead {
      background-color: #f5f5f5;
    }
    th, td {
      border: 1px solid #ccc;
      padding: 12px;
      text-align: left;
    }
    tr:hover {
      background-color: #f0f8ff;
    }
    a {
      color: #007bff;
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }
    .btn-delete {
      background-color: #e74c3c;
      color: white;
      border: none;
      padding: 6px 12px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 14px;
      transition: background-color 0.3s ease;
    }
    .btn-delete:hover {
      background-color: #c0392b;
    }
    .btn-create {
      background-color: #2ecc71;
      color: white;
      padding: 10px 15px;
      text-decoration: none;
      border-radius: 4px;
    }
    .btn-create:hover {
      background-color: #27ae60;
    }
  </style>
</head>
<body>

  <h2><%= pageTitle %></h2>

  <form action="/subscribers/search" method="get" style="margin-bottom: 20px;">
    <input type="text" name="term" placeholder="Rechercher par nom ou code postal">
    <button type="submit">Rechercher</button>
  </form>

  <% if (notification) { %>
    <div class="notification"><%= notification %></div>
  <% } %>

  <table>
    <thead>
      <tr>
        <th>Nom</th>
        <th>Email</th>
        <th>Code Postal</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (subscribers.length === 0) { %>
        <tr>
          <td colspan="4">Aucun abonné trouvé.</td>
        </tr>
      <% } else { %>
        <% subscribers.forEach(subscriber => { %>
          <tr>
            <td><a href="/subscribers/<%= subscriber._id %>"><%= subscriber.name %></a></td>
            <td><%= subscriber.email %></td>
            <td><%= subscriber.zipCode %></td>
            <td>
              <a href="/subscribers/<%= subscriber._id %>/edit" class="edit-btn">
                <i class="fas fa-pen"></i> Modifier
              </a>
              <form action="/subscribers/<%= subscriber._id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Confirmer la suppression ?');">
                <button type="submit" class="btn-delete">
                  <i class="fas fa-trash"></i> Supprimer
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>

  <a href="/subscribers/new" class="btn-create">Créer un nouvel abonné</a>

</body>
</html>


