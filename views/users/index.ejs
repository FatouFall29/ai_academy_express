<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Liste des utilisateurs</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
    }
    h2 {
      margin-top: 30px;
      margin-bottom: 20px;
      color: #0d6efd;
    }
    .table thead th {
      background-color: #e9ecef;
    }
    .btn-sm {
      padding: 0.25rem 0.5rem;
    }
    .action-buttons a {
      margin-right: 5px;
    }
  </style>
</head>
<body>
  <div class="container mt-4">
    <h2>Liste des utilisateurs</h2>

    <table class="table table-bordered shadow-sm bg-white">
      <thead class="table-light">
        <tr>
          <th>Nom</th>
          <th>Email</th>
          <th>Code Postal</th>
          <th>Modifier</th>
          <th>Supprimer</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
          <tr>
            <td>
              <a href="/users/<%= user._id %>" class="text-decoration-none text-primary">
                <%= user.fullName %>
              </a>
            </td>
            <td><%= user.email %></td>
            <td><%= user.zipCode %></td>
            <td>
              <a href="/users/<%= user._id %>/edit" class="btn btn-outline-primary btn-sm">Modifier</a>
            </td>
       
              <td>
                <form action="/users/<%= user._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?')">
                  <button type="submit" class="btn btn-outline-primary btn-sm">Supprimer</button>
                </form>
              </td>
              
              
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <div class="mt-4">
      <a href="/users/new" class="btn btn-primary">Créer un nouvel utilisateur</a>
    </div>
  </div>
</body>
</html>
